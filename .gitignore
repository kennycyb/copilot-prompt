# This is a template .gitignore - customize it for your specific project

# IDE and Editor files
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/.ropeproject
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
.Python

# Build outputs
dist/
build/
*.egg-info/
target/
out/
.next/

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# OS files
Thumbs.db
